includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 8
	treatPhpDocTypesAsCertain: false
	# Include new root files and nested/split production code without a path-list edit.
	paths:
		- .
	scanDirectories:
		- src
	# Keep synthetic development declarations out of production symbol discovery too.
	excludePaths:
		analyseAndScan:
			# Root-relative development surfaces retain syntax/standards/behavior gates.
			- tests/*
			- scripts/*
			# Dependencies and disposable state are not maintained production sources.
			- vendor/*
			- node_modules/*
			- .git/*
			- .phpunit.cache/*
			- .workspaces/*
			- coverage/*
