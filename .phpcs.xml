<?xml version="1.0"?>
<ruleset name="RAN WP Release Updater Coding Standards">
	<description>WordPress, PHP compatibility, and project coding standards for the release updater.</description>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="8.2-"/>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/.phpunit.cache/</exclude-pattern>
	<exclude-pattern>/.workspaces/</exclude-pattern>
	<exclude-pattern>/coverage/</exclude-pattern>
	<!-- This file is generated byte-for-byte from ran/updater-support and verified separately. -->
	<exclude-pattern>/src/Dependency/ArchiveSafety.php</exclude-pattern>
	<!-- Historical compatibility fixtures intentionally retain their original source shape. -->
	<exclude-pattern>/tests/Fixtures/protocol2/</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress-Extra">
		<!-- Classes are PSR-style runtime symbols and retain class-case filenames. -->
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<!-- Public and internal OOP APIs intentionally use camelCase. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<!-- Yoda rewrites would create broad semantic diffs without improving this sealed runtime. -->
		<exclude name="WordPress.PHP.YodaConditions"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/</exclude-pattern>
		<exclude-pattern>/scripts/</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_wp_release_updater"/>
				<element value="RAN\"/>
			</property>
		</properties>
	</rule>

	<!-- WPCS hard-codes a four-character minimum; the project namespace is RAN. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound">
		<severity>0</severity>
	</rule>

	<!-- WordPress hooks and compatibility contracts retain required parameter names. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.CodeAnalysis.UselessOverridingMethod">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>

	<!-- Security-sensitive filesystem code intentionally uses native primitives for custody and atomicity. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/src/Archive/</exclude-pattern>
		<exclude-pattern>/src/WordPress/NativePluginUpdater.php</exclude-pattern>
		<exclude-pattern>/scripts/</exclude-pattern>
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.NoSilencedErrors">
		<exclude-pattern>/src/Archive/</exclude-pattern>
		<exclude-pattern>/src/WordPress/NativePluginUpdater.php</exclude-pattern>
		<exclude-pattern>/scripts/</exclude-pattern>
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
</ruleset>
