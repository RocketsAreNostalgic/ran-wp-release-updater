<?xml version="1.0"?>
<ruleset name="RAN WP Release Updater Coding Standards">
	<description>WordPress, PHP compatibility, and project coding standards for the release updater.</description>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.2-"/>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/.phpunit.cache/</exclude-pattern>
	<exclude-pattern>/.workspaces/</exclude-pattern>
	<exclude-pattern>/coverage/</exclude-pattern>
	<!-- This file is generated byte-for-byte from ran/updater-support and verified separately. -->
	<exclude-pattern>/src/Dependency/ArchiveSafety.php</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressLibrary"/>

	<!-- All maintained production, entrypoint, tool and test PHP, including future roots. Generated code is excluded above. -->
	<rule ref="RANOwnedMethods"/>

	<!-- All tests share owned method naming; required foreign signatures use exact local exceptions. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
	<!-- Match owned-method scope across all maintained PHP. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName"/>
	<!-- Conditions are checked across all maintained PHP, including test fixtures. -->
	<rule ref="WordPress.PHP.YodaConditions"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/scripts/</exclude-pattern>
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_wp_release_updater"/>
				<element value="RAN\WPReleaseUpdater\V1\"/>
			</property>
		</properties>
	</rule>

	<!-- Unused owned parameters are checked; required foreign stub signatures use local exceptions. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>

	<!-- Reserved parameter names are checked; the existing foreign skin override retains a local exception. -->
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames"/>

	<!--
		This is a library, not a rendering layer. Exception messages are internal
		failure data and are never emitted as HTML; escaping them would corrupt the
		closed failure protocol rather than improve output safety.
	-->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped"><severity>0</severity></rule>

	<!--
		Canonical protocol/hash JSON deliberately uses native json_encode() with
		JSON_THROW_ON_ERROR and exact flags. wp_json_encode() is not available at
		all bootstrap boundaries and would make byte identity depend on WordPress.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.json_encode_json_encode"><severity>0</severity></rule>

	<!--
		URL canonicalization is part of the provider-neutral runtime and bootstrap
		contract. It must work before WordPress helpers are guaranteed to exist.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.parse_url_parse_url"><severity>0</severity></rule>

	<!-- Native operations and warning suppression are checked in tests; required fixture primitives use exact local exceptions. -->
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>

	<!-- Bootstrap and the runtime-copy selector read local trusted runtime metadata, never remote URLs. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>^(?!.*?/tests/).*?/bootstrap\.php$</exclude-pattern>
		<exclude-pattern>/src/Runtime/RuntimeCopySelector.php</exclude-pattern>
	</rule>

	<!--
		BindingFenceCoordinator validates the options-table identifier before use
		and prepares every data value. WPCS cannot follow that closed identifier/CAS
		construction through the local SQL variable, so suppress only those parser
		false positives for this single persistence boundary.
	-->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<exclude-pattern>/src/WordPress/BindingFenceCoordinator.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL.NotPrepared">
		<exclude-pattern>/src/WordPress/BindingFenceCoordinator.php</exclude-pattern>
	</rule>

	<!-- NativePackageUpdater uses URL-safe base64 solely as a bounded opaque operation token, never to conceal executable code. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
		<exclude-pattern>/src/WordPress/NativePackageUpdater.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
		<exclude-pattern>/src/WordPress/NativePackageUpdater.php</exclude-pattern>
	</rule>

	<!--
		Test helpers follow owned naming and syntax rules. Foreign declarations,
		synthetic fixtures, controlled globals and CLI diagnostics retain exact
		local exceptions with their concrete contract reasons.
	-->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions.error_log_var_export"/>
	<rule ref="Universal.Operators.DisallowShortTernary.Found"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>/scripts/</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_exec"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_proc_open">
		<exclude-pattern>/scripts/lint-php.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv"/>
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed"/>
	<rule ref="Universal.Namespaces.DisallowCurlyBraceSyntax.Forbidden"/>
	<rule ref="Universal.Namespaces.OneDeclarationPerFile.MultipleFound"/>
	<rule ref="Universal.Namespaces.DisallowDeclarationWithoutName.Forbidden"/>
	<rule ref="Generic.Files.OneObjectStructurePerFile"/>
	<rule ref="Generic.Classes.DuplicateClassName.Found"/>
	<rule ref="Generic.CodeAnalysis.EmptyStatement.DetectedCatch"/>
	<rule ref="Generic.CodeAnalysis.ForLoopWithTestFunctionCall.NotAllowed"/>
	<rule ref="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
	<rule ref="WordPress.DB.RestrictedFunctions.mysql_mysqli_init"/>
	<rule ref="WordPress.DB.RestrictedFunctions.mysql_mysqli_real_connect"/>
	<rule ref="WordPress.DB.RestrictedFunctions.mysql_mysqli_report"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize"/>
	<rule ref="Squiz.PHP.Eval.Discouraged"/>
	<rule ref="Generic.Strings.UnnecessaryStringConcat.Found"/>
	<rule ref="Squiz.Operators.IncrementDecrementUsage.NoBrackets"/>
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>/scripts/lint-php.php</exclude-pattern>
	</rule>
</ruleset>
