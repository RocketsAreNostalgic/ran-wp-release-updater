{
  "name": "ran/wp-release-updater",
  "description": "Provider-neutral release update integration for WordPress plugins and themes.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/RocketsAreNostalgic/ran-updater-support"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-zip": "*"
  },
  "conflict": {
    "ran/wp-github-release-updater": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpcompatibility/php-compatibility": "^10.0@dev",
    "phpcompatibility/phpcompatibility-paragonie": "^2.0@dev",
    "phpcompatibility/phpcompatibility-wp": "^3.0@dev",
    "phpcsstandards/phpcsutils": "^1.2.2",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0",
    "ran/updater-support": "dev-main",
    "squizlabs/php_codesniffer": "^3.13.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "support": {
    "issues": "https://github.com/RocketsAreNostalgic/ran-wp-release-updater/issues",
    "security": "https://github.com/RocketsAreNostalgic/ran-wp-release-updater/security/advisories/new",
    "source": "https://github.com/RocketsAreNostalgic/ran-wp-release-updater"
  },
  "scripts": {
    "check": [
      "@validate:strict",
      "@check:updater-support",
      "@audit:composer",
      "@lint:syntax",
      "@lint:php",
      "@analyze",
      "@test:unit",
      "@test:no-dev-consumer"
    ],
    "check:phase3": [
      "@check",
      "@test:parity"
    ],
    "check:php-style": "@lint:php",
    "analyze": "phpstan analyse --configuration=phpstan.neon --no-progress --memory-limit=1G",
    "audit:composer": "composer audit --locked --no-interaction",
    "format:php": "phpcbf --standard=.phpcs.xml --report=summary",
    "lint:php": "phpcs --standard=.phpcs.xml --report=summary",
    "lint:syntax": "php scripts/lint-php.php",
    "test:unit": "phpunit --configuration phpunit.xml",
    "test:no-dev-consumer": "php tests/Integration/no-dev-consumer.php",
    "test:parity": "php tests/Integration/paired-github-provider-proof.php",
    "test:wordpress-integration": "@php tests/Integration/wordpress-integration.php",
    "test:wordpress-bulk": "php tests/Integration/wordpress-native-mixed-bulk-proof.php",
    "test:release-publisher": "node --test tests/release-publisher.test.mjs",
    "validate:strict": "composer validate --strict --no-check-publish",
    "sync:updater-support": "php scripts/sync-updater-support.php",
    "check:updater-support": "php scripts/sync-updater-support.php --check"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
