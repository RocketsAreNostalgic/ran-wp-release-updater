includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	# Deliberately no paths: the runner supplies exactly one discovered test file.
	level: 5
	treatPhpDocTypesAsCertain: false
	# Fixtures mutate updater state through callbacks and global harness registries.
	rememberPossiblyImpureFunctionValues: false
	scanDirectories:
		- src
